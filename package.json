{
  "name": "docspace-server",
  "version": "3.5.0-beta",
  "description": "Serveur de chat DocSpace en temps réel — interface Retro Discord, vocal, salons, profils, progression et outils sociaux",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --check server.js && node --check public/app.js && node --check public/arcade.js && node --check public/voice.js && node --test tests/integration.test.cjs",
    "lint": "echo \"Linting à implémenter\" && exit 0",
    "clean": "rm -rf uploads/* && echo \"Dossier uploads nettoyé\"",
    "logs": "tail -f logs/server.log"
  },
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^12.7.0",
    "multer": "^2.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jsdom": "^26.1.0",
    "socket.io-client": "^4.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/g4bplayer83-glitch/DocSpace.git"
  },
  "keywords": [
    "chat",
    "socket.io",
    "realtime",
    "multiplatform",
    "file-sharing",
    "notifications",
    "websocket",
    "nodejs",
    "express",
    "fly.io",
    "firebase"
  ],
  "author": {
    "name": "g4bplayer83",
    "email": "votre-email@example.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/g4bplayer83-glitch/chatroom-server/issues"
  },
  "homepage": "https://github.com/g4bplayer83-glitch/chatroom-server#readme",
  "config": {
    "port": "8080",
    "host": "0.0.0.0",
    "maxFileSize": "100MB",
    "maxAvatarSize": "10MB",
    "maxHistoryMessages": 100
  },
  "render": {
    "buildCommand": "npm install",
    "startCommand": "npm start"
  }
}
