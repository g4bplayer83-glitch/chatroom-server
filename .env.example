# Copie ce fichier sous le nom .env pour ton serveur local.
# Sur Fly.io, configure les secrets avec flyctl secrets set.
PORT=8080
HOST=0.0.0.0
DOCSPACE_VOICE_MODE=p2p
DOCSPACE_SELF_KEEPALIVE=false
# Mot de passe administrateur distinct du mot de passe de ton compte.
# Vide = mode administrateur désactivé. Utilise une valeur longue et privée.
ADMIN_PASSWORD=
# Facultatif : recherche de GIFs. Les fichiers GIF et liens directs fonctionnent sans clé.
GIPHY_API_KEY=
# Facultatif : codes Plus à usage unique, séparés par des virgules.
DOCSPACE_PLUS_CODES=
# Facultatif : relais pour les appels entre réseaux restrictifs.
DOCSPACE_TURN_URLS=
DOCSPACE_TURN_USERNAME=
DOCSPACE_TURN_CREDENTIAL=

# Facultatif : suggestions et recherche via YouTube Data API v3
YOUTUBE_API_KEY=
